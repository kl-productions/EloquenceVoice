+#if defined(__APPLE__) && defined(__aarch64__)
+
+/* Apple's arm64 differs from every other 64-bit target here in two ways, and
+   the calls below get both wrong without this.
+ *
+ *   - A variadic function's unnamed arguments are on the stack, never in
+ *     registers, where System V and Windows pass them just like named ones.
+ *     Six entries are variadic: setNonSequential walks its with va_arg.
+ *   - Arguments past the eighth are packed on the stack at their own size, so
+ *     an int32_t takes four bytes, not an eight-byte slot. The shims with
+ *     nine or more int32_t arguments read the wrong half of each.
+ *
+ * Every argument an entry takes past the eighth is either a pointer or an
+ * int32_t, and the mask already says which, so those calls are laid out by
+ * hand here and made through evv_call_packed. Only those: every other call is
+ * made the ordinary way below. Declared as nothing but addresses to compare
+ * against; their real prototypes live with their definitions. */
+extern void setNonSequential(void);
+extern void registerLanguage(void);
+extern void registerPhoneme(void);
+extern void registerVoice(void);
+extern void registerSAPIVoice(void);
+extern void callSynthesizeArray(void);
+
+/* How many named arguments a variadic entry has, or -1 for one that is not. */
+static int variadic_named(delta_rule_fn fn)
+{
+    if (fn == (delta_rule_fn)setNonSequential)
+        return 2;
+    if (fn == (delta_rule_fn)callSynthesizeArray)
+        return 14;
+    if (fn == (delta_rule_fn)registerLanguage
+        || fn == (delta_rule_fn)registerPhoneme
+        || fn == (delta_rule_fn)registerVoice
+        || fn == (delta_rule_fn)registerSAPIVoice)
+        return 1;
+    return -1;
+}
+
+/* x0 the function, x1 eight register words, x2 the stack block, x3 its size
+   (a multiple of sixteen). Loads the registers, puts the block at the stack
+   pointer, calls, and answers with x0. */
+evv_word evv_call_packed(delta_rule_fn fn, const evv_word *regs,
+                         const uint8_t *stack, size_t bytes);
+
+__asm__(
+".text\n"
+".p2align 2\n"
+".globl _evv_call_packed\n"
+".private_extern _evv_call_packed\n"
+"_evv_call_packed:\n"
+"    stp x29, x30, [sp, #-16]!\n"
+"    mov x29, sp\n"
+"    sub sp, sp, x3\n"
+"    mov x16, x0\n"
+"    mov x17, x1\n"
+"    mov x9, #0\n"
+"1:  cmp x9, x3\n"
+"    b.hs 2f\n"
+"    ldrb w10, [x2, x9]\n"
+"    strb w10, [sp, x9]\n"
+"    add x9, x9, #1\n"
+"    b 1b\n"
+"2:  ldp x0, x1, [x17, #0]\n"
+"    ldp x2, x3, [x17, #16]\n"
+"    ldp x4, x5, [x17, #32]\n"
+"    ldp x6, x7, [x17, #48]\n"
+"    blr x16\n"
+"    mov sp, x29\n"
+"    ldp x29, x30, [sp], #16\n"
+"    ret\n"
+);
+
+static evv_word call_apple(delta_rule_fn fn, uint32_t m, const int32_t *a,
+                           int n, int named)
+{
+    evv_word regs[8];
+    uint8_t  stack[25 * 8 + 16];
+    size_t   off = 0;
+    int      i, reg = 0;
+
+    memset(regs, 0, sizeof regs);
+    memset(stack, 0, sizeof stack);
+    if (n > 25)
+        n = 25;
+    for (i = 0; i < n; i++) {
+        evv_word w = WM(m, i, a[i]);
+        int      isNamed = named < 0 || i < named;
+
+        if (isNamed && reg < 8) {
+            regs[reg++] = w;
+        } else if (!isNamed || ((m >> i) & 1u)) {
+            off = (off + 7) & ~(size_t)7;
+            memcpy(stack + off, &w, 8);
+            off += 8;
+        } else {
+            int32_t v = (int32_t)w;
+
+            off = (off + 3) & ~(size_t)3;
+            memcpy(stack + off, &v, 4);
+            off += 4;
+        }
+    }
+    off = (off + 15) & ~(size_t)15;
+    return evv_call_packed(fn, regs, stack, off);
+}
+
+#endif
