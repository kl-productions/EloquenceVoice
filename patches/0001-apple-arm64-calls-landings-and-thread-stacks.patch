+/* The same two halves for 64-bit ARM, which is every Apple silicon Mac and
+   every iPhone. setjmp cannot stand in here: evv_land_save would be a
+   function wrapping it, and landing later restores that function's frame
+   after it has returned, so it goes back through a return address that
+   something else has since written over.
+
+   A call on ARM leaves the stack pointer where it was and the return address
+   in x30, so saving both on entry lands exactly where the save returned to.
+   Saved: the callee's x19 to x28, the frame pointer x29, x30, the stack
+   pointer and d8 to d15, the callee-saved half of the floating point
+   registers, in 168 bytes. x18 is the platform's and is left alone. */
+#if defined(__APPLE__)
+#define EVV_ARM_SYM(n) "_" #n
+#define EVV_LAND_HIDE \
+    ".private_extern _evv_land_save\n" \
+    ".private_extern _evv_land_jump\n"
+#else
+#define EVV_ARM_SYM(n) #n
+#define EVV_LAND_HIDE \
+    ".hidden evv_land_save\n" \
+    ".hidden evv_land_jump\n"
+#endif
+
+__asm__(
+".text\n"
+".p2align 2\n"
+".globl " EVV_ARM_SYM(evv_land_save) "\n"
+".globl " EVV_ARM_SYM(evv_land_jump) "\n"
+EVV_LAND_HIDE
+
+EVV_ARM_SYM(evv_land_save) ":\n"
+"    stp x19, x20, [x0, #0]\n"
+"    stp x21, x22, [x0, #16]\n"
+"    stp x23, x24, [x0, #32]\n"
+"    stp x25, x26, [x0, #48]\n"
+"    stp x27, x28, [x0, #64]\n"
+"    stp x29, x30, [x0, #80]\n"
+"    mov x16, sp\n"
+"    str x16, [x0, #96]\n"
+"    stp d8, d9, [x0, #104]\n"
+"    stp d10, d11, [x0, #120]\n"
+"    stp d12, d13, [x0, #136]\n"
+"    stp d14, d15, [x0, #152]\n"
+"    mov w0, #0\n"
+"    ret\n"
+
+EVV_ARM_SYM(evv_land_jump) ":\n"
+"    ldp x19, x20, [x0, #0]\n"
+"    ldp x21, x22, [x0, #16]\n"
+"    ldp x23, x24, [x0, #32]\n"
+"    ldp x25, x26, [x0, #48]\n"
+"    ldp x27, x28, [x0, #64]\n"
+"    ldp x29, x30, [x0, #80]\n"
+"    ldr x16, [x0, #96]\n"
+"    mov sp, x16\n"
+"    ldp d8, d9, [x0, #104]\n"
+"    ldp d10, d11, [x0, #120]\n"
+"    ldp d12, d13, [x0, #136]\n"
+"    ldp d14, d15, [x0, #152]\n"
+"    mov w0, w1\n"
+"    ret\n"
+);
